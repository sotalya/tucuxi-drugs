                <absorptionParameters>
                    <parameterSetAnalyteGroup>
                        <analyteGroupId>ponatinib</analyteGroupId>
                        <absorptionModel>extra.lag</absorptionModel>
                        <parameterSet>
                            <parameters>
                                <parameter>
                                    <parameterId>F</parameterId>
                                    <unit>-</unit>
                                    <parameterValue>
                                        <standardValue>1</standardValue>
                                    </parameterValue>
                                    <bsv>
                                        <bsvType>none</bsvType>
                                        <stdDevs />
                                    </bsv>
                                    <validation>
                                        <errorMessage>
                                            <text lang='en'>F should be positive</text>
                                        </errorMessage>
                                        <operation>
                                            <softFormula>
                                                <inputs>
                                                    <input>
                                                        <id>F</id>
                                                        <type>double</type>
                                                    </input>
                                                </inputs>
                                                <code>
                                                    <![CDATA[
                                                    return F <= 1.0 and F > 0.0;
                                                        ]]>
                                                    </code>
                                                </softFormula>
                                                <comments/>
                                            </operation>
                                            <comments/>
                                        </validation>
                                        <comments>
                                            <comment lang='en'>The absorption model of the publication has been simplified, keeping only the Ka with lag time component, and dropping the transit compartments component (with its variability) from the original analysis</comment>
                                        </comments>
                                    </parameter>
                                    <parameter>
                                        <parameterId>Ka</parameterId>
                                        <unit>h-1</unit>
                                        <parameterValue>
                                            <standardValue>4.41</standardValue>
                                        </parameterValue>
                                        <bsv>
                                            <bsvType>none</bsvType>
                                            <stdDevs />
                                        </bsv>
                                        <validation>
                                            <errorMessage>
                                                <text lang='en'>Ka should be positive</text>
                                            </errorMessage>
                                            <operation>
                                                <softFormula>
                                                    <inputs>
                                                        <input>
                                                            <id>Ka</id>
                                                            <type>double</type>
                                                        </input>
                                                    </inputs>
                                                    <code>
                                                        <![CDATA[
                                                        return Ka > 0.0;
                                                        ]]>
                                                    </code>
                                                </softFormula>
                                                <comments/>
                                            </operation>
                                            <comments/>
                                        </validation>
                                        <comments/>
                                    </parameter>
                                    <parameter>
                                        <parameterId>Tlag</parameterId>
                                        <unit>h</unit>
                                        <parameterValue>
                                            <standardValue>3.932</standardValue>
                                        </parameterValue>
                                        <bsv>
                                            <bsvType>none</bsvType>
                                            <stdDevs />
                                        </bsv>
                                        <validation>
                                            <errorMessage>
                                                <text lang='en'>Tlag should be positive</text>
                                            </errorMessage>
                                            <operation>
                                                <softFormula>
                                                    <inputs>
                                                        <input>
                                                            <id>Tlag</id>
                                                            <type>double</type>
                                                        </input>
                                                    </inputs>
                                                    <code>
                                                        <![CDATA[
                                                        return Tlag >= 0.0;
                                                        ]]>
                                                    </code>
                                                </softFormula>
                                                <comments/>
                                            </operation>
                                            <comments/>
                                        </validation>
                                        <comments/>
                                    </parameter>
                                </parameters>
                                <correlations />
                            </parameterSet>
                        </parameterSetAnalyteGroup>
                    </absorptionParameters>
                </formulationAndRoute>
            </formulationAndRoutes>
            <timeConsiderations>
                <halfLife>
                    <unit>h</unit>
                    <duration>
                        <standardValue>22</standardValue>
                    </duration>
                    <multiplier>10</multiplier>
                    <comments>
                        <comment lang='en'>The hallf life estimate is taken from the summary of product characteristics of Iclusig</comment>
                    </comments>
                </halfLife>
                <outdatedMeasure>
                    <unit>d</unit>
                    <duration>
                        <standardValue>28</standardValue>
                    </duration>
                    <comments>
                        <comment lang='en'>To be checked</comment>
                    </comments>
                </outdatedMeasure>
            </timeConsiderations>
            <comments/>
        </drugModel>
    </model>
