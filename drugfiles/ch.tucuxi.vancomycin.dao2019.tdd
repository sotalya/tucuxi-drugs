                            </from>
                            <to>
                                <standardValue>50</standardValue>
                            </to>
                            <step>
                                <standardValue>2</standardValue>
                            </step>
                        </rangeValues>
                        <rangeValues>
                            <from>
                                <standardValue>55</standardValue>
                            </from>
                            <to>
                                <standardValue>100</standardValue>
                            </to>
                            <step>
                                <standardValue>5</standardValue>
                            </step>
                        </rangeValues>
                        <rangeValues>
                            <from>
                                <standardValue>110</standardValue>
                            </from>
                            <to>
                                <standardValue>200</standardValue>
                            </to>
                            <step>
