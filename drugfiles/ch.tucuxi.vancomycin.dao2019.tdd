                        </fixedValues>
                    </availableIntervals>
                    <availableInfusions>
                        <unit>min</unit>
                        <default>
                            <standardValue>60</standardValue>
                        </default>
                        <fixedValues>
                            <value>30</value>
                            <value>60</value>
                            <value>120</value>
                        </fixedValues>
                    </availableInfusions>
                    <comments/>
                </dosages>
                <absorptionParameters>
                </absorptionParameters>
            </formulationAndRoute>
        </formulationAndRoutes>
        <timeConsiderations>
            <halfLife>
                <unit>h</unit>
                <duration>
                    <standardValue>4</standardValue>
                </duration>
                <multiplier>15</multiplier>
                <comments/>
            </halfLife>
            <outdatedMeasure>
                <unit>d</unit>
                <duration>
