
$SUB ADVAN2 TRANS2

$PK
MEANBW=70;
FBW=(bodyweight-MEANBW)/MEANBW;

MEANAG=50;
FAGE=(age-MEANAG)/MEANAG;

IF (gist.EQ.1) PATH=1;
IF (gist.EQ.0) PATH=0;

TVCL = THETA(1)+THETA(5)*FBW+THETA(6)*sex-THETA(6)*(1-sex)+THETA(7)*FAGE + THETA(8)*PATH-THETA(8)*(1-PATH);

CL=TVCL * EXP(ETA(1))
TVV=THETA(2)+THETA(11)*sex-THETA(11)*(1-sex)
V=TVV * EXP(ETA(2))
KA=THETA(3)
KEL=CL/V
S2=V/1000


$THETA
14.3 FIX ; CL
347 FIX; V
0.609 FIX; Ka
1; F
5.42 FIX
1.49 FIX
-5.81 FIX
-0.806 FIX
70 FIX
50 FIX
46.2 FIX
