; Tobramycin model for patients with and without cystic fibrosis, from Hennig 2013.
; Written by Yann Thoma
; Final version : 26.02.2021

$INCLUDE general.header

$PROBLEM Tobramycin model, from Hennig 2013. A priori prediction.

$INPUT ID TIME EVID AMT CMT SS II DV age sex scr bodyweight height clcr RATE

$INCLUDE general.dataimport

$INCLUDE ch.tucuxi.tobramycin.hennig2013.pkmodel

; No residual error, as we just compute an apriori prediction
$ERROR
Y=F
IPRED=F


; No inter-individual variability, as we just compute an apriori prediction
$OMEGA 0.0 STANDARD FIX
$OMEGA 0.0 STANDARD FIX
$OMEGA 0.0 STANDARD FIX
$OMEGA 0.0 STANDARD FIX

; No residual error, as we just compute an apriori prediction
$SIGMA 0 FIXED;

$INCLUDE general.apriori.footer
