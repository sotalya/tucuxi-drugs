$INCLUDE general.header

$PROBLEM Tacrolimus lung. A priori percentiles.

$INPUT ID TIME EVID AMT CMT SS II DV cysticfibrosis gene_CYP3A45

$INCLUDE general.dataimport

$INCLUDE ch.tucuxi.tacrolimus.monchaud2012.pkmodel


$ERROR

Y = F + ETA(6) * SQRT(F * F * THETA(7) * THETA(7)  + THETA(6) * THETA(6))
if (Y.LT.0) Y = 0
IPRED=Y



$OMEGA STANDARD CORRELATION BLOCK(5) FIX
0.427
0 0.41
0 0 0.717
0 0 0 1.26
0 0 0 0 0.537

$OMEGA 1 FIX; EPS1 ; Replacement of SIGMA

; Sigma is replaced by an additional Omega
$SIGMA 0.0 STANDARD FIX

