$INCLUDE general.header

$PROBLEM PK_Model_Chen et al.A priori prediction

$INPUT ID TIME EVID AMT CMT SS II DV bodyweight CLCR age RATE

$INCLUDE general.dataimport

$INCLUDE ch.tucuxi.piperacillin.chen2016.pkmodel

; No residual error, as we just compute an apriori prediction
$ERROR
Y=F
IPRED=F


; No inter-individual variability, as we just compute an apriori prediction
$OMEGA STANDARD CORRELATION BLOCK(2) FIX
0.0; ETA CL
0 0.0; ETA V1


; No residual error, as we just compute an apriori prediction
$SIGMA 0 FIXED;

$INCLUDE general.apriori.footer
