$INCLUDE general.header

$PROBLEM Vancomycin for hemodialysis patients. A priori prediction.

$INPUT ID TIME EVID AMT CMT SS II DV bodyweight creatinine_concentra creatinine age sex clcr hemodialysis RATE

$INCLUDE general.dataimport

$INCLUDE ch.tucuxi.vancomycin.goti2018.pkmodel

; No residual error, as we just compute an apriori prediction
$ERROR
Y=F
IPRED=F


; No inter-individual variability, as we just compute an apriori prediction
$OMEGA 0.0 STANDARD FIX
$OMEGA 0.0 STANDARD FIX
$OMEGA 0.0 STANDARD FIX
$OMEGA 0.0 STANDARD FIX

; No residual error, as we just compute an apriori prediction
$SIGMA 0 FIXED;

$INCLUDE general.apriori.footer
