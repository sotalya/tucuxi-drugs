
$SUB ADVAN3 TRANS4

$PK

isMale = sex - 0.5
sex_factor = 1.04
IF (isMale.GE.0) sex_factor = 1.23
IF (isMale.LT.0) sex_factor = 1.04

; We calculate the CLcr instead of using the one passed as parameter
; OperationEGFRCockcroftGaultGeneral
CLcrIn = (140 - age) * (bodyweight / creatinine) * sex_factor;


; TVCL = THETA(1) * ((CLcrIn / 66) ** THETA(2));
TVCL = THETA(1) * (CLcrIn * THETA(2));
CL = TVCL * EXP(ETA(1))

TVV1 = THETA(3) * bodyweight;
V1 = TVV1 * EXP(ETA(2))

TVV2 = THETA(4) * bodyweight;
V2 = TVV2 * EXP(ETA(3))

TVQ = THETA(5);
Q = TVQ * EXP(ETA(4))


S1 = V1 / 1000


$THETA (2.99) FIX; 1 CL
$THETA (0.0154) FIX; 2 CLcr on CL
$THETA (0.675) FIX ; 3 V1
$THETA (0.732) FIX ; 4 V2
$THETA (2.28) FIX ; 5 Q
1600 ; 6 Additive residual error, in ug/l
0.15 ; 7 Proportional residual error
