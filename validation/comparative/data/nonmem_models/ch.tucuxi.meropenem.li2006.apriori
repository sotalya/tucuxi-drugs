$INCLUDE general.header

$PROBLEM PK_Model_LI et al.A priori prediction

$INPUT ID TIME EVID AMT CMT SS II DV age CLCR bodyweight RATE

$INCLUDE general.dataimport

$INCLUDE ch.tucuxi.meropenem.li2006.pkmodel

; No residual error, as we just compute an apriori prediction
$ERROR
Y=F
IPRED=F


; No inter-individual variability, as we just compute an apriori prediction
$OMEGA STANDARD CORRELATION BLOCK(4) FIX
0.0; ETA CL
0 0.0; ETA V1
0 0 0.0; ETA V2
0 0 0 0.0; ETA Q


; No residual error, as we just compute an apriori prediction
$SIGMA 0 FIXED;

$INCLUDE general.apriori.footer
