$INCLUDE general.header

$PROBLEM IMATINIB Model Predictions Study PK-PD GIST. A priori prediction.

$INPUT ID TIME EVID AMT CMT SS II DV age bodyweight CLcr RATE

$INCLUDE general.dataimport

$INCLUDE ch.tucuxi.vancomycin.staatz2005.pkmodel


$ERROR
;W=SQRT(F*F*THETA(4) + THETA(5))

Y = F + ETA(3) * SQRT(F * F * THETA(5) * THETA(5)  + THETA(4) * THETA(4))
if (Y.LT.0) Y = 0
IPRED=F


$OMEGA STANDARD CORRELATION BLOCK(2) FIX
0.25; IIV CL
0.0 0.33; IIV V
$OMEGA 1 FIX; EPS1 ; Replacement of SIGMA

; Sigma is replaced by an additional Omega
$SIGMA
0.0 STANDARD FIX
0.0 STANDARD FIX

$INCLUDE general.apriori.perc.footer
