
$SUB ADVAN3 TRANS4

$PK


isMale = sex - 0.5
sex_factor = 1.04
IF (isMale.GT.0) sex_factor = 1.23
IF (isMale.LT.0) sex_factor = 1.04
; We calculate the CLcr instead of using the one passed as parameter
; OperationEGFRCockcroftGaultGeneral
; Here we use scr instead of creatinine
eGFR = (140 - age) * (bodyweight / creatinine_concentra) * sex_factor;

TVCL = THETA(1) * ((eGFR / 120) ** THETA(2)) * (THETA(3) ** hemodialysis);
CL = TVCL * EXP(ETA(1))

TVV1 = THETA(4) * (bodyweight / 70) * (THETA(5) ** hemodialysis);
V1 = TVV1 * EXP(ETA(2))

TVV2 = 38.4;
V2 = TVV2 * EXP(ETA(3))

TVQ = 6.5;
Q = TVQ


S1 = V1 / 1000


$THETA (4.5) FIX; 1 CL
$THETA (0.8) FIX; 2 CLcr on CL
$THETA (0.7) FIX; 3 DIAL on CL
$THETA (58.4) FIX ; 4 V1
$THETA (0.5) FIX ; 5 DIAL on V1
3400 ; 6 Additive residual error, in ug/l
0.227 ; 7 Proportional residual error
