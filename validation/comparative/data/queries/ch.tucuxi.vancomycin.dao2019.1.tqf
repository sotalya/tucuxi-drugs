        </request>
        <request>
            <requestId>population_1_percentiles</requestId>
            <drugId>vancomycin</drugId>
            <drugModelId>ch.tucuxi.vancomycin.dao2019</drugModelId>
            <percentilesTraits>
              <computingOption>
                <parametersType>population</parametersType>
