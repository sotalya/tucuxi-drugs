              </computingOption>
              <nbPointsPerHour>20</nbPointsPerHour>
              <dateInterval>
                  <start>2023-01-20T12:00:00</start>
                  <end>2023-01-25T12:00:00</end>
              </dateInterval>
              <ranks>
                  <rank>5</rank>
                  <rank>10</rank>
                  <rank>25</rank>
                  <rank>50</rank>
                  <rank>75</rank>
                  <rank>90</rank>
                  <rank>95</rank>
              </ranks>
